<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<title>Avaliação Estratégica de Candidatos · FOPAG · Banco Inter</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============================================================
   TOKENS
   ============================================================ */
:root{
  --bg-0:#0A0E14;
  --bg-1:#10151F;
  --bg-2:#161C29;
  --bg-3:#1E2635;
  --line:#2A3346;
  --line-soft:#212a3a;
  --ink-0:#F3F5F9;
  --ink-1:#B7C0D1;
  --ink-2:#7C8AA3;
  --ink-3:#4E5A72;

  --inter-orange:#FF7A00;
  --inter-orange-2:#FF9640;
  --inter-orange-soft:rgba(255,122,0,.14);
  --teal:#00D6C4;
  --teal-soft:rgba(0,214,196,.14);

  --good:#22C55E;
  --good-soft:rgba(34,197,94,.14);
  --warn:#F5B92E;
  --warn-soft:rgba(245,185,46,.14);
  --bad:#F5484B;
  --bad-soft:rgba(245,72,75,.14);

  --radius-lg:20px;
  --radius-md:14px;
  --radius-sm:10px;
  --shadow-card:0 1px 0 rgba(255,255,255,.03) inset, 0 20px 40px -24px rgba(0,0,0,.6);
  --ease:cubic-bezier(.22,1,.36,1);
}

*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  background:
    radial-gradient(1200px 620px at 12% -10%, rgba(255,122,0,.10), transparent 60%),
    radial-gradient(900px 520px at 100% 0%, rgba(0,214,196,.08), transparent 55%),
    var(--bg-0);
  color:var(--ink-0);
  font-family:'Inter',system-ui,sans-serif;
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
}
h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif; letter-spacing:-.01em;}
.mono{font-family:'JetBrains Mono',monospace;}
a{color:inherit;}
::selection{background:var(--inter-orange); color:#0A0E14;}
@media (prefers-reduced-motion: reduce){ *{animation-duration:.001ms !important; transition-duration:.001ms !important;} }

/* focus visibility */
button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible{
  outline:2px solid var(--teal); outline-offset:2px; border-radius:8px;
}

/* ============================================================
   LAYOUT SHELL
   ============================================================ */
.shell{max-width:1180px; margin:0 auto; padding:0 24px;}

/* ---------- top bar ---------- */
.topbar{
  position:sticky; top:0; z-index:40;
  backdrop-filter:blur(14px) saturate(140%);
  background:rgba(10,14,20,.72);
  border-bottom:1px solid var(--line-soft);
}
.topbar-inner{
  max-width:1180px; margin:0 auto; padding:14px 24px;
  display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
}
.brand{display:flex; align-items:center; gap:12px;}
.brand-mark{
  width:38px; height:38px; border-radius:11px;
  background:linear-gradient(155deg, var(--inter-orange), #C24E00);
  display:flex; align-items:center; justify-content:center;
  font-family:'Space Grotesk'; font-weight:700; font-size:15px; color:#fff;
  box-shadow:0 6px 18px -6px rgba(255,122,0,.6);
  flex-shrink:0;
}
.brand-text{display:flex; flex-direction:column; line-height:1.25;}
.brand-text b{font-size:14.5px; font-weight:700;}
.brand-text span{font-size:12px; color:var(--ink-2);}
.topbar-tag{
  display:flex; align-items:center; gap:8px;
  font-size:12.5px; color:var(--ink-1);
  background:var(--bg-2); border:1px solid var(--line);
  padding:7px 12px 7px 10px; border-radius:999px;
}
.topbar-tag .dot{width:7px; height:7px; border-radius:50%; background:var(--good); box-shadow:0 0 0 3px var(--good-soft);}

/* ---------- gestor chip ---------- */
.gestor-chip{
  display:flex; align-items:center; gap:10px;
  background:var(--bg-2); border:1px solid var(--line);
  padding:6px 8px 6px 14px; border-radius:999px; font-size:12.5px; color:var(--ink-1);
  cursor:pointer; transition:border-color .2s var(--ease), background .2s var(--ease);
}
.gestor-chip:hover{border-color:var(--inter-orange); background:var(--bg-3);}
.gestor-chip .avatar-mini{
  width:24px; height:24px; border-radius:50%;
  background:linear-gradient(155deg, var(--teal), #067f74);
  display:flex; align-items:center; justify-content:center;
  font-size:10.5px; font-weight:700; color:#04211d;
}

/* ============================================================
   HERO
   ============================================================ */
.hero{padding:56px 0 34px; position:relative;}
.eyebrow{
  display:inline-flex; align-items:center; gap:8px;
  font-size:12.5px; font-weight:600; letter-spacing:.02em;
  color:var(--inter-orange-2);
  background:var(--inter-orange-soft); border:1px solid rgba(255,122,0,.35);
  padding:6px 13px 6px 11px; border-radius:999px; margin-bottom:20px;
}
.hero h1{
  font-size:clamp(30px,4.6vw,46px); font-weight:700; margin:0 0 14px; line-height:1.08;
  max-width:820px;
}
.hero h1 em{font-style:normal; color:var(--inter-orange-2);}
.hero p{
  max-width:700px; color:var(--ink-1); font-size:15.5px; line-height:1.65; margin:0 0 32px;
}
.hero p b{color:var(--ink-0); font-weight:600;}

.stat-grid{
  display:grid; grid-template-columns:repeat(4,1fr); gap:14px;
}
.stat-card{
  background:linear-gradient(180deg, var(--bg-2), var(--bg-1));
  border:1px solid var(--line); border-radius:var(--radius-md);
  padding:20px 20px 18px; box-shadow:var(--shadow-card);
  position:relative; overflow:hidden;
  transition:transform .35s var(--ease), border-color .35s var(--ease);
}
.stat-card::before{
  content:""; position:absolute; inset:0 0 auto 0; height:2px;
  background:var(--stat-accent, var(--inter-orange));
}
.stat-card:hover{transform:translateY(-3px); border-color:var(--line-soft);}
.stat-num{font-family:'Space Grotesk'; font-size:32px; font-weight:700; line-height:1; margin-bottom:8px;
  font-variant-numeric:tabular-nums;}
.stat-label{font-size:12.5px; color:var(--ink-2); font-weight:500;}
.stat-card.st-total{--stat-accent:var(--teal);}
.stat-card.st-approved{--stat-accent:var(--good);}
.stat-card.st-approved .stat-num{color:var(--good);}
.stat-card.st-rejected{--stat-accent:var(--bad);}
.stat-card.st-rejected .stat-num{color:var(--bad);}
.stat-card.st-pending{--stat-accent:var(--inter-orange);}

@media (max-width:820px){ .stat-grid{grid-template-columns:repeat(2,1fr);} }

/* ============================================================
   SECTION HEADERS
   ============================================================ */
.section{padding:38px 0;}
.section-head{display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:26px; flex-wrap:wrap;}
.section-head h2{font-size:22px; margin:0 0 6px;}
.section-head p{margin:0; color:var(--ink-2); font-size:13.5px;}
.section-kicker{
  font-size:11.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase;
  color:var(--teal); margin-bottom:8px; display:block;
}

/* ============================================================
   TIMELINE (vagas)
   ============================================================ */
.pipeline{
  display:flex; gap:10px; overflow-x:auto; padding-bottom:6px; margin-bottom:8px;
  scrollbar-width:thin;
}
.pipeline::-webkit-scrollbar{height:6px;}
.pipeline::-webkit-scrollbar-thumb{background:var(--line); border-radius:6px;}
.pipeline-item{
  flex:0 0 auto; display:flex; align-items:center; gap:10px;
  background:var(--bg-2); border:1px solid var(--line); border-radius:999px;
  padding:9px 16px 9px 10px; font-size:12.5px; color:var(--ink-1);
  cursor:pointer; transition:all .25s var(--ease); white-space:nowrap;
}
.pipeline-item .num{
  width:22px; height:22px; border-radius:50%; background:var(--bg-3);
  display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700;
  font-family:'JetBrains Mono'; color:var(--ink-2); flex-shrink:0;
}
.pipeline-item.active{border-color:var(--inter-orange); background:var(--inter-orange-soft); color:var(--ink-0);}
.pipeline-item.active .num{background:var(--inter-orange); color:#1a0d00;}
.pipeline-item:hover{border-color:var(--ink-3);}

/* ============================================================
   VAGA BLOCK
   ============================================================ */
.vaga-block{
  border:1px solid var(--line); border-radius:var(--radius-lg);
  background:linear-gradient(180deg, rgba(30,38,53,.55), rgba(16,21,31,.4));
  padding:26px; margin-bottom:22px;
  scroll-margin-top:90px;
  animation:rise .5s var(--ease) both;
}
@keyframes rise{ from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:none;} }

.vaga-head{display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:20px;}
.vaga-head-left{display:flex; gap:14px; align-items:flex-start;}
.vaga-icon{
  width:46px; height:46px; border-radius:12px; flex-shrink:0;
  background:var(--bg-3); border:1px solid var(--line);
  display:flex; align-items:center; justify-content:center; font-size:19px;
}
.vaga-id{font-family:'JetBrains Mono'; font-size:11.5px; color:var(--ink-2); letter-spacing:.02em;}
.vaga-title{font-size:18px; font-weight:700; margin:3px 0 6px; font-family:'Space Grotesk';}
.vaga-meta{display:flex; gap:14px; flex-wrap:wrap; font-size:12.5px; color:var(--ink-1);}
.vaga-meta span{display:inline-flex; align-items:center; gap:6px;}
.badge-modelo{
  background:var(--teal-soft); color:var(--teal); border:1px solid rgba(0,214,196,.3);
  padding:4px 10px; border-radius:999px; font-size:11.5px; font-weight:600; white-space:nowrap;
}
.badge-count{
  background:var(--bg-3); border:1px solid var(--line); color:var(--ink-1);
  padding:6px 13px; border-radius:999px; font-size:12px; font-weight:600; white-space:nowrap;
}
.multi-note{
  margin-top:16px; padding:12px 16px; border-radius:var(--radius-sm);
  background:var(--inter-orange-soft); border:1px solid rgba(255,122,0,.3);
  font-size:13px; color:var(--inter-orange-2); display:flex; gap:10px; align-items:flex-start;
}

/* candidates grid inside a vaga */
.cand-grid{display:grid; grid-template-columns:1fr; gap:16px;}
.vaga-block.multi .cand-grid{grid-template-columns:repeat(auto-fit, minmax(300px,1fr));}

/* ============================================================
   CANDIDATE CARD
   ============================================================ */
.cand-card{
  border:1px solid var(--line); border-radius:var(--radius-md);
  background:var(--bg-1);
  padding:22px; box-shadow:var(--shadow-card);
  transition:border-color .3s var(--ease), transform .3s var(--ease);
  display:flex; flex-direction:column; gap:16px;
}
.cand-card:hover{border-color:var(--line-soft); transform:translateY(-2px);}
.cand-card.is-decided{border-color:var(--ink-3);}
.cand-card.decided-approved{border-color:rgba(34,197,94,.45); background:linear-gradient(180deg, rgba(34,197,94,.05), var(--bg-1) 40%);}
.cand-card.decided-rejected{border-color:rgba(245,72,75,.45); background:linear-gradient(180deg, rgba(245,72,75,.05), var(--bg-1) 40%);}

.cand-top{display:flex; justify-content:space-between; gap:14px;}
.cand-id{display:flex; gap:12px; align-items:center; min-width:0;}
.avatar{
  width:46px; height:46px; border-radius:50%; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  font-family:'Space Grotesk'; font-weight:700; font-size:15px; color:#fff;
  background:linear-gradient(155deg, var(--av-a,#FF7A00), var(--av-b,#C24E00));
}
.cand-name-wrap{min-width:0;}
.cand-name{font-weight:700; font-size:15.5px; margin:0 0 3px; font-family:'Space Grotesk';}
.cand-link{font-size:12px; color:var(--teal); text-decoration:none; display:inline-flex; align-items:center; gap:4px;}
.cand-link:hover{text-decoration:underline;}
.cand-nolink{font-size:12px; color:var(--ink-3);}

/* aderencia ring */
.aderencia{display:flex; flex-direction:column; align-items:center; gap:2px; flex-shrink:0;}
.aderencia .ring{position:relative; width:58px; height:58px;}
.aderencia svg{transform:rotate(-90deg);}
.aderencia .track{fill:none; stroke:var(--bg-3); stroke-width:5;}
.aderencia .bar{fill:none; stroke-width:5; stroke-linecap:round; transition:stroke-dashoffset 1s var(--ease);}
.aderencia .pct{
  position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
  font-family:'JetBrains Mono'; font-weight:600; font-size:12.5px;
}
.aderencia .lbl{font-size:9.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-3); font-weight:600;}
.lvl-good .bar{stroke:var(--good);} .lvl-good .pct{color:var(--good);}
.lvl-warn .bar{stroke:var(--warn);} .lvl-warn .pct{color:var(--warn);}
.lvl-bad .bar{stroke:var(--bad);} .lvl-bad .pct{color:var(--bad);}

.cand-tags{display:flex; flex-wrap:wrap; gap:7px;}
.tag{
  font-size:11.5px; padding:5px 10px; border-radius:999px; border:1px solid var(--line);
  color:var(--ink-1); background:var(--bg-2); display:inline-flex; align-items:center; gap:5px;
}
.tag.tag-ok{color:var(--good); border-color:rgba(34,197,94,.3); background:var(--good-soft);}
.tag.tag-alert{color:var(--bad); border-color:rgba(245,72,75,.35); background:var(--bad-soft); font-weight:600;}
.tag.tag-warn{color:var(--warn); border-color:rgba(245,185,46,.35); background:var(--warn-soft); font-weight:600;}

.cand-summary{margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:7px;}
.cand-summary li{
  font-size:13px; color:var(--ink-1); line-height:1.5; padding-left:18px; position:relative;
}
.cand-summary li::before{
  content:"›"; position:absolute; left:0; color:var(--inter-orange-2); font-weight:700;
}

.cand-entrevista-btn{
  margin-top:10px; width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px;
}
.cand-parecer{
  margin-top:10px; padding:12px 14px; border-radius:10px;
  background:var(--bg-2); border:1px dashed var(--line);
  font-size:12.5px; color:var(--ink-1); line-height:1.55;
}
.cand-parecer b{color:var(--ink-0);}
.crivo-legend{
  display:flex; flex-wrap:wrap; gap:8px; margin:12px 0 14px;
}
.crivo-pill{
  font-size:11px; padding:4px 10px; border-radius:999px; border:1px solid var(--line);
  display:inline-flex; align-items:center; gap:6px;
}
.cv-exp{background:var(--good-soft); color:var(--good); border-color:rgba(34,197,94,.35);}
.cv-dem{background:var(--teal-soft); color:var(--teal); border-color:rgba(0,214,196,.35);}
.cv-cit{background:var(--warn-soft); color:var(--warn); border-color:rgba(245,185,46,.35);}
.cv-nao{background:var(--bg-3); color:var(--ink-2); border-color:var(--line);}
.crivo-grid{display:grid; grid-template-columns:1fr; gap:8px;}
.crivo-item{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  padding:9px 12px; background:var(--bg-2); border:1px solid var(--line-soft); border-radius:9px;
  font-size:12.5px; color:var(--ink-1);
}
.crivo-note{
  margin-top:14px; padding:12px 14px; border-radius:10px;
  background:var(--warn-soft); border:1px solid rgba(245,185,46,.3);
  font-size:12.5px; color:var(--ink-1); line-height:1.55;
}
.validation-section{
  margin:26px 0 8px; padding:22px 24px; border-radius:var(--radius-lg);
  background:var(--bg-1); border:1px solid var(--line); box-shadow:var(--shadow-card);
}
.validation-section h2{font-size:20px; margin:0 0 6px;}
.validation-section p.sub2{font-size:13px; color:var(--ink-2); margin:0 0 14px;}
.validation-list{list-style:none; margin:0; padding:0; display:grid; gap:10px;}
.validation-list li{
  display:flex; gap:10px; align-items:flex-start;
  padding:11px 14px; background:var(--bg-2); border:1px solid var(--line-soft); border-radius:10px;
  font-size:13px; color:var(--ink-1); line-height:1.55;
}
.validation-list li .vmark{flex-shrink:0; font-size:14px; line-height:1.4;}

.entrevista-topico{
  margin-bottom:14px; padding:12px 14px; background:var(--bg-2);
  border:1px solid var(--line); border-radius:10px;
}
.entrevista-topico .et-head{display:flex; justify-content:space-between; gap:10px; margin-bottom:6px;}
.entrevista-topico .et-head b{font-size:13px;}
.entrevista-topico .et-nota{font-size:12px; color:var(--teal);}
.entrevista-topico ul{margin:0 0 6px; padding-left:18px; font-size:12.5px; color:var(--ink-1); line-height:1.5;}
.entrevista-topico ul.et-atencao{margin-bottom:0; color:var(--warn);}
.entrevista-meta{font-size:12.5px; color:var(--ink-1); line-height:1.7; margin:0 0 16px;}
.entrevista-veredito{
  margin-top:16px; padding:14px; background:var(--teal-soft);
  border:1px solid rgba(0,214,196,.3); border-radius:10px;
}
.entrevista-veredito b{font-size:12.5px; color:var(--teal);}
.entrevista-veredito p{font-size:12.5px; color:var(--ink-1); margin:6px 0 0; line-height:1.6;}
.entrevista-cols{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px;}
.entrevista-cols h4{font-size:13px; margin:0 0 8px;}
.entrevista-cols ul{margin:0; padding-left:18px; font-size:12.5px; color:var(--ink-1); line-height:1.5;}
@media (max-width:640px){ .entrevista-cols{grid-template-columns:1fr;} }

.cand-alert-box{
  border:1px solid rgba(245,72,75,.35); background:var(--bad-soft); border-radius:var(--radius-sm);
  padding:12px 14px; font-size:12.5px; color:#ffb3b4; display:flex; gap:9px; align-items:flex-start; line-height:1.5;
}
.cand-alert-box.warn{border-color:rgba(245,185,46,.35); background:var(--warn-soft); color:#ffe1a3;}

/* ---------- decision area ---------- */
.decision-area{border-top:1px dashed var(--line); padding-top:16px;}
.decision-actions{display:flex; gap:10px;}
.btn{
  border:1px solid var(--line); background:var(--bg-2); color:var(--ink-0);
  font-family:inherit; font-size:13px; font-weight:600; padding:10px 16px; border-radius:var(--radius-sm);
  cursor:pointer; display:inline-flex; align-items:center; gap:8px; transition:all .2s var(--ease); flex:1; justify-content:center;
}
.btn-approve{border-color:rgba(34,197,94,.4);}
.btn-approve:hover, .btn-approve.selected{background:var(--good-soft); border-color:var(--good); color:#7CFFA6;}
.btn-reject{border-color:rgba(245,72,75,.4);}
.btn-reject:hover, .btn-reject.selected{background:var(--bad-soft); border-color:var(--bad); color:#ffb3b4;}
.btn:disabled{opacity:.45; cursor:not-allowed;}

.justif-wrap{margin-top:14px; display:none; animation:rise .35s var(--ease) both;}
.justif-wrap.open{display:block;}
.justif-wrap label{
  display:block; font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
  color:var(--ink-2); margin-bottom:8px;
}
.justif-wrap textarea{
  width:100%; min-height:78px; resize:vertical;
  background:var(--bg-2); border:1px solid var(--line); border-radius:var(--radius-sm);
  color:var(--ink-0); font-family:inherit; font-size:13px; padding:11px 13px; line-height:1.5;
}
.justif-wrap textarea::placeholder{color:var(--ink-3);}
.justif-footer{display:flex; justify-content:space-between; align-items:center; margin-top:10px; gap:10px;}
.justif-hint{font-size:11.5px; color:var(--ink-3);}
.justif-confirm-row{display:flex; gap:8px;}
.btn-ghost{background:transparent; border:1px solid var(--line); color:var(--ink-2); padding:9px 14px; font-size:12.5px;}
.btn-ghost:hover{border-color:var(--ink-3); color:var(--ink-0);}
.btn-confirm{
  background:linear-gradient(155deg, var(--inter-orange), #C24E00); border:none; color:#fff;
  padding:9px 16px; font-size:12.5px; box-shadow:0 8px 18px -8px rgba(255,122,0,.55);
}
.btn-confirm:hover{filter:brightness(1.08);}
.btn-confirm:disabled{opacity:.4; box-shadow:none;}

.decided-flag{
  display:flex; align-items:center; gap:10px; font-size:12.5px; padding:10px 12px; border-radius:var(--radius-sm);
}
.decided-flag.approved{color:#7CFFA6; background:var(--good-soft); border:1px solid rgba(34,197,94,.35);}
.decided-flag.rejected{color:#ffb3b4; background:var(--bad-soft); border:1px solid rgba(245,72,75,.35);}
.decided-flag small{display:block; color:var(--ink-2); font-weight:400; margin-top:2px;}
.decided-flag .redo{
  margin-left:auto; background:none; border:none; color:inherit; text-decoration:underline;
  font-size:11.5px; cursor:pointer; opacity:.75; font-family:inherit;
}
.decided-flag .redo:hover{opacity:1;}

