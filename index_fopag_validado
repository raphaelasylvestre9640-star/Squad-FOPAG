            {t:"Batch Processing", c:"nao"},
            {t:"Qualidade e Governança de Dados", c:"nao"},
            {t:"Data Lineage", c:"nao"},
            {t:"Data Catalog", c:"nao"},
            {t:"Data Mesh (quando aplicável)", c:"nao"},
            {t:"Performance de consultas", c:"nao"},
            {t:"Particionamento", c:"nao"},
            {t:"Otimização de pipelines", c:"nao"},
            {t:"Cloud Data Services (AWS, Azure ou GCP)", c:"nao"},
            {t:"Arquiteturas modernas de Engenharia de Dados", c:"nao"},
            {t:"Escalabilidade", c:"nao"},
            {t:"Observabilidade de pipelines", c:"nao"},
            {t:"Segurança e LGPD aplicada a dados", c:"nao"}
          ],
          conclusao: "Veredito do crivo: NÃO AVALIÁVEL no estado atual. A classificação de todos os 21 tópicos como \"Não evidenciado\" não significa que o candidato não domine os temas — significa que não há evidência de entrevista neste documento para sustentar qualquer grau. Ação obrigatória: agendar entrevista técnica cobrindo os tópicos acima e reprocessar este crivo com base na transcrição resultante."
        }
      }
    ]
  }
];

/* aggregate flat candidate index -> {vaga, candidato} */
const ALL = [];
VAGAS.forEach(v => v.candidatos.forEach(c => ALL.push({vaga:v, cand:c})));

/* ============================================================
   STATE
   ============================================================ */
const LS_DECISIONS = "fopag_decisions_v1";
const LS_GESTOR = "fopag_gestor_v1";

function loadDecisions(){
  try{ return JSON.parse(localStorage.getItem(LS_DECISIONS)) || {}; }catch(e){ return {}; }
}
function saveDecisions(d){ localStorage.setItem(LS_DECISIONS, JSON.stringify(d)); }
function loadGestor(){
  try{ return JSON.parse(localStorage.getItem(LS_GESTOR)) || null; }catch(e){ return null; }
}
function saveGestor(g){ localStorage.setItem(LS_GESTOR, JSON.stringify(g)); }

let decisions = loadDecisions(); // { key: {status, justificativa, data, hora, gestorNome, gestorCargo, vagaId, vagaCargo, candidato} }
let gestor = loadGestor();
let pendingAction = null; // {key, status}

/* ============================================================
   RENDER — PIPELINE
   ============================================================ */
const pipelineEl = document.getElementById('pipeline');
VAGAS.forEach((v,i)=>{
  const el = document.createElement('div');
  el.className = 'pipeline-item';
  el.innerHTML = `<span class="num">${i+1}</span> ${v.cargo.replace('Desenvolvedor Java/React ','')} <span class="mono" style="color:var(--ink-3); margin-left:4px;">#${v.id}</span>`;
  el.addEventListener('click', ()=>{
    document.getElementById('vaga-'+v.id).scrollIntoView({behavior:'smooth', block:'start'});
  });
  pipelineEl.appendChild(el);
});

/* ============================================================
   RENDER — VAGAS + CANDIDATOS
   ============================================================ */
const vagasContainer = document.getElementById('vagasContainer');

function ringColor(pct){
  if(pct>=90) return 'lvl-good';
  if(pct>=75) return 'lvl-warn';
  return 'lvl-bad';
}

function renderAderenciaRing(pct, label){
  const r = 24, c = 2*Math.PI*r;
  const offset = c - (pct/100)*c;
  return `
  <div class="aderencia ${ringColor(pct)}">
    <div class="ring">
      <svg width="58" height="58" viewBox="0 0 58 58">
        <circle class="track" cx="29" cy="29" r="${r}"/>
        <circle class="bar" cx="29" cy="29" r="${r}" stroke-dasharray="${c}" stroke-dashoffset="${offset}"/>
      </svg>
      <div class="pct">${pct}%</div>
    </div>
    <div class="lbl">${label || 'Aderência'}</div>
  </div>`;
}

function initials(name){
  return name.split(' ').filter(Boolean).slice(0,2).map(w=>w[0]).join('').toUpperCase();
}

function candCardHTML(vaga, cand){
  const dec = decisions[cand.key];
  const decidedClass = dec ? (dec.status==='Aprovado' ? 'decided-approved is-decided' : 'decided-rejected is-decided') : '';
  const linkHTML = cand.linkedin
    ? `<a class="cand-link" href="${cand.linkedin}" target="_blank" rel="noopener">🔗 Ver perfil no LinkedIn</a>`
    : `<span class="cand-nolink">LinkedIn não informado</span>`;
  const opcaoTag = cand.opcaoLabel ? `<span class="badge-count" style="margin-bottom:6px; display:inline-block;">${cand.opcaoLabel}</span><br>` : '';

  const tagsHTML = cand.tags.map(t=>{
    const cls = t.alert ? 'tag tag-alert' : (t.ok ? 'tag tag-ok' : 'tag');
    return `<span class="${cls}">${t.t}</span>`;
  }).join('');

  const summaryHTML = cand.resumo.map(r=>`<li>${r}</li>`).join('');

  const alertHTML = cand.alert
    ? `<div class="cand-alert-box ${cand.alert.level==='warn'?'warn':''}">⚠️ ${cand.alert.text}</div>`
    : '';

  const parecerHTML = cand.parecer
    ? `<div class="cand-parecer"><b>🧾 Parecer executivo (revisado)</b><br>${cand.parecer}</div>`
    : '';

  const crivoBtnHTML = cand.crivo
    ? `<button class="btn btn-ghost cand-entrevista-btn" data-crivo="${cand.key}">🧪 Crivo de Engenharia de Dados — Staff/Principal</button>`
    : '';

  const decisionAreaHTML = dec ? `
    <div class="decision-area">
      <div class="decided-flag ${dec.status==='Aprovado'?'approved':'rejected'}">
        <span>${dec.status==='Aprovado' ? '✅' : '❌'}</span>
        <div>
          ${dec.status} por ${dec.gestorNome} ${dec.gestorCargo ? '· '+dec.gestorCargo : ''}
          <small>${dec.data} às ${dec.hora} — "${dec.justificativa}"</small>
        </div>
        <button class="redo" data-redo="${cand.key}">alterar decisão</button>
      </div>
    </div>
  ` : `
    <div class="decision-area">
      <div class="decision-actions">
        <button class="btn btn-approve" data-act="Aprovado" data-key="${cand.key}">✓ Aprovar</button>
        <button class="btn btn-reject" data-act="Reprovado" data-key="${cand.key}">✕ Reprovar</button>
      </div>
      <div class="justif-wrap" id="justif-${cand.key}">
        <label for="ta-${cand.key}">Justificativa <span style="color:var(--bad);">*</span></label>
        <textarea id="ta-${cand.key}" placeholder="Descreva o motivo da decisão para o candidato ${cand.nome}..."></textarea>
        <div class="justif-footer">
          <span class="justif-hint" id="hint-${cand.key}">Obrigatório para confirmar.</span>
          <div class="justif-confirm-row">
            <button class="btn btn-ghost" data-cancel="${cand.key}">Cancelar</button>
            <button class="btn btn-confirm" data-confirm="${cand.key}" disabled>Confirmar decisão</button>
          </div>
        </div>
      </div>
    </div>
  `;

  return `
  <div class="cand-card ${decidedClass}" id="card-${cand.key}">
    <div class="cand-top">
      <div class="cand-id">
        <div class="avatar" style="--av-a:${cand.avA}; --av-b:${cand.avB};">${initials(cand.nome)}</div>
        <div class="cand-name-wrap">
          ${opcaoTag}
          <p class="cand-name">${cand.nome}</p>
          ${linkHTML}
        </div>
      </div>
      ${renderAderenciaRing(cand.aderencia, cand.aderenciaLabel)}
    </div>
    <div class="cand-tags">${tagsHTML}</div>
    <ul class="cand-summary">${summaryHTML}</ul>
    ${alertHTML}
    ${parecerHTML}
    ${crivoBtnHTML}
    ${decisionAreaHTML}
  </div>`;
}

function vagaBlockHTML(vaga){
  const candsHTML = vaga.candidatos.map(c=>candCardHTML(vaga,c)).join('');
  const noteHTML = vaga.note ? `<div class="multi-note">🧭 ${vaga.note}</div>` : '';
  return `
  <div class="vaga-block ${vaga.multi?'multi':''}" id="vaga-${vaga.id}">
    <div class="vaga-head">
      <div class="vaga-head-left">
        <div class="vaga-icon">${vaga.icon}</div>
        <div>
          <div class="vaga-id">VAGA #${vaga.id} · BANCO INTER</div>
          <div class="vaga-title">${vaga.cargo}</div>
          <div class="vaga-meta">
            <span class="badge-modelo">📍 ${vaga.modelo}</span>
          </div>
        </div>
      </div>
      <div class="badge-count">${vaga.candidatos.length} ${vaga.multi ? 'opções em análise' : 'candidato enviado'}</div>
    </div>
    ${noteHTML}
    <div class="cand-grid">${candsHTML}</div>
  </div>`;
}

function renderVagas(){
  vagasContainer.innerHTML = VAGAS.map(vagaBlockHTML).join('');
  attachCardEvents();
}

/* ============================================================
   EVENTS — DECISION FLOW
   ============================================================ */
function attachCardEvents(){
  document.querySelectorAll('[data-act]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.dataset.key;
      const act = btn.dataset.act;
      // toggle selected visual state among the pair
      const wrap = document.getElementById('justif-'+key);
      const card = document.getElementById('card-'+key);
      card.querySelectorAll('[data-act]').forEach(b=>b.classList.remove('selected'));
      btn.classList.add('selected');
      wrap.classList.add('open');
      wrap.dataset.status = act;
      document.getElementById('ta-'+key).focus();
    });
  });

  document.querySelectorAll('[data-cancel]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.dataset.cancel;
      const wrap = document.getElementById('justif-'+key);
      wrap.classList.remove('open');
      document.getElementById('card-'+key).querySelectorAll('[data-act]').forEach(b=>b.classList.remove('selected'));
      document.getElementById('ta-'+key).value = '';
      updateConfirmState(key);
    });
  });

  document.querySelectorAll('textarea[id^="ta-"]').forEach(ta=>{
    const key = ta.id.replace('ta-','');
    ta.addEventListener('input', ()=>updateConfirmState(key));
  });

  document.querySelectorAll('[data-confirm]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.dataset.confirm;
      confirmDecision(key);
    });
  });

  document.querySelectorAll('[data-redo]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.dataset.redo;
      delete decisions[key];
      saveDecisions(decisions);
      renderVagas();
      renderLog();
      renderStats();
    });
  });

  document.querySelectorAll('[data-crivo]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      openCrivo(btn.dataset.crivo);
    });
  });
}

/* ============================================================
   MODAL — CRIVO DE ENGENHARIA DE DADOS
   ============================================================ */
const CRIVO_LABELS = {
  exp: {txt:"Experiência comprovada", cls:"cv-exp"},
  dem: {txt:"Conhecimento demonstrado", cls:"cv-dem"},
  cit: {txt:"Conhecimento citado", cls:"cv-cit"},
  nao: {txt:"Não evidenciado", cls:"cv-nao"}
};

function openCrivo(key){
  const found = ALL.find(x=>x.cand.key===key);
  if(!found || !found.cand.crivo) return;
  const cand = found.cand;
  const cr = cand.crivo;

  document.getElementById('crivoModalTitle').textContent = `🧪 Crivo de Engenharia de Dados — ${cand.nome}`;

  const legendHTML = Object.values(CRIVO_LABELS).map(l=>
    `<span class="crivo-pill ${l.cls}">${l.txt}</span>`).join('');

  const itemsHTML = cr.topicos.map(t=>{
    const l = CRIVO_LABELS[t.c] || CRIVO_LABELS.nao;
    return `<div class="crivo-item"><span>${t.t}</span><span class="crivo-pill ${l.cls}">${l.txt}</span></div>`;
  }).join('');

  document.getElementById('crivoModalBody').innerHTML = `
    <p style="font-size:13px; color:var(--ink-1); line-height:1.6; margin:0 0 6px;">${cr.contexto}</p>
    <div class="crivo-legend">${legendHTML}</div>
    <div class="crivo-grid">${itemsHTML}</div>
    <div class="crivo-note"><b>⚠️ ${''}</b>${cr.conclusao}</div>
  `;
  openModal('crivoModal');
}

function updateConfirmState(key){
  const ta = document.getElementById('ta-'+key);
  const confirmBtn = document.querySelector(`[data-confirm="${key}"]`);
  const hint = document.getElementById('hint-'+key);
  const ok = ta.value.trim().length >= 8;
  confirmBtn.disabled = !ok;
  hint.textContent = ok ? 'Pronto para confirmar.' : 'Obrigatório — mínimo de 8 caracteres.';
  hint.style.color = ok ? 'var(--good)' : 'var(--ink-3)';
}

function confirmDecision(key){
  if(!gestor){
    pendingAction = {key};
    openModal('gestorModal');
    return;
  }
  const wrap = document.getElementById('justif-'+key);
  const status = wrap.dataset.status;
  const justificativa = document.getElementById('ta-'+key).value.trim();
  if(justificativa.length < 8) return;

  const found = ALL.find(x=>x.cand.key===key);
  const now = new Date();
  decisions[key] = {
    status,
    justificativa,
    data: now.toLocaleDateString('pt-BR'),
    hora: now.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'}),
    gestorNome: gestor.nome,
    gestorCargo: gestor.cargo,
    vagaId: found.vaga.id,
    vagaCargo: found.vaga.cargo,
    candidato: found.cand.nome
  };
  saveDecisions(decisions);
  renderVagas();
  renderLog();
  renderStats();
  document.getElementById('logSection').scrollIntoView({behavior:'smooth', block:'nearest'});
}

/* ============================================================
   STATS
   ============================================================ */
function renderStats(){
  const total = ALL.length;
  const vals = Object.values(decisions);
  const approved = vals.filter(d=>d.status==='Aprovado').length;
  const rejected = vals.filter(d=>d.status==='Reprovado').length;
  document.getElementById('statTotal').textContent = total;
  document.getElementById('statApproved').textContent = approved;
  document.getElementById('statRejected').textContent = rejected;
  document.getElementById('statPending').textContent = total - approved - rejected;

  document.getElementById('logProgressNum').textContent = vals.length;
  document.getElementById('progressFill').style.width = Math.round((vals.length/total)*100) + '%';
}

/* ============================================================
   DECISION LOG
   ============================================================ */
function renderLog(){
  const listEl = document.getElementById('logList');
  const vals = Object.values(decisions).sort((a,b)=> (a.data+a.hora < b.data+b.hora ? 1 : -1));
  if(vals.length === 0){
    listEl.innerHTML = `<div class="log-empty">Nenhuma decisão registrada ainda. As aprovações e reprovações aparecerão aqui em tempo real.</div>`;
    return;
  }
  listEl.innerHTML = vals.map(d=>`
    <div class="log-row">
      <div class="log-when">${d.data}<br>${d.hora}</div>
      <div class="log-body">
        <b>${d.candidato}</b>
        <div class="log-sub">Vaga #${d.vagaId} · ${d.vagaCargo} — decidido por ${d.gestorNome}${d.gestorCargo ? ' · '+d.gestorCargo : ''}</div>
        <div class="log-just">"${d.justificativa}"</div>
      </div>
      <div class="log-status ${d.status==='Aprovado'?'aprovado':'reprovado'}">${d.status}</div>
    </div>
  `).join('');
}

/* ============================================================
   GESTOR MODAL
   ============================================================ */
function openModal(id){ document.getElementById(id).classList.add('open'); }
function closeModal(id){ document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('[data-close]').forEach(btn=>{
  btn.addEventListener('click', ()=>closeModal(btn.dataset.close));
});
document.querySelectorAll('.modal-overlay').forEach(ov=>{
  ov.addEventListener('click', (e)=>{ if(e.target===ov) closeModal(ov.id); });
});

function refreshGestorChip(){
  const label = document.getElementById('gestorLabel');
  const av = document.getElementById('gestorInitials');
  if(gestor){
    label.textContent = `${gestor.nome}${gestor.cargo ? ' · '+gestor.cargo : ''}`;
    av.textContent = initials(gestor.nome);
  } else {
    label.textContent = 'Definir gestor responsável';
    av.textContent = '?';
  }
}

document.getElementById('gestorChip').addEventListener('click', ()=>{
  if(gestor){
    document.getElementById('gestorNomeInput').value = gestor.nome;
    document.getElementById('gestorCargoInput').value = gestor.cargo;
  }
  openModal('gestorModal');
});

document.getElementById('saveGestorBtn').addEventListener('click', ()=>{
  const nome = document.getElementById('gestorNomeInput').value.trim();
  const cargo = document.getElementById('gestorCargoInput').value.trim();
  if(!nome){
    document.getElementById('gestorNomeInput').focus();
    return;
  }
  gestor = {nome, cargo};
  saveGestor(gestor);
  refreshGestorChip();
  closeModal('gestorModal');
  if(pendingAction){
    confirmDecision(pendingAction.key);
    pendingAction = null;
  }
});

/* ============================================================
   GERAR LISTA PARA ENVIAR
   ============================================================ */
document.getElementById('genListBtn').addEventListener('click', ()=>{
  const vals = Object.values(decisions).sort((a,b)=> (a.data+a.hora < b.data+b.hora ? -1 : 1));
  let text = `AVALIAÇÃO DE CANDIDATOS — PROJETO FOPAG (BANCO INTER)\nCliente: Fernando Cascais\n\n`;
  if(vals.length === 0){
    text += "Nenhuma decisão registrada até o momento.";
  } else {
    vals.forEach(d=>{
      text += `Vaga #${d.vagaId} — ${d.vagaCargo}\nCandidato: ${d.candidato}\nStatus: ${d.status}\nJustificativa: ${d.justificativa}\nGestor: ${d.gestorNome}${d.gestorCargo ? ' ('+d.gestorCargo+')' : ''}\nData: ${d.data} às ${d.hora}\n\n`;
    });
  }
  document.getElementById('listPreview').textContent = text.trim();
  document.getElementById('copyListBtn').dataset.text = text.trim();
  openModal('listModal');
});

document.getElementById('copyListBtn').addEventListener('click', async ()=>{
  const text = document.getElementById('copyListBtn').dataset.text || '';
  try{
    await navigator.clipboard.writeText(text);
  }catch(e){
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
  }
  const toast = document.getElementById('toast');
  toast.classList.add('show');
  setTimeout(()=>toast.classList.remove('show'), 2600);
});

/* ============================================================
   INIT
   ============================================================ */
refreshGestorChip();
renderVagas();
renderLog();
renderStats();
</script>
</body>
</html>
